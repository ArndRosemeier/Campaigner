# Logs
logs
*.log
# Gate run logs: the gate writes them INTO the workspace (GATE_LOGDIR) so a
# background run's evidence survives — /tmp is private per call in this harness.
.gate-logs/
# The suite lock. It MUST live on a shared path: /tmp is a per-call, read-only
# tmpfs in this harness, so a /tmp lock cannot exclude a second gate at all.
.gate-lock/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
coverage

# Sandbox-local pnpm caches (not part of the project)
.pnpm-home

*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local sample rulebooks (large, copyrighted — never commit)
Sample rules/

# Local backup zips (user data — never commit)
campaigner-backup-*.zip

# Python bytecode from local deploy scripts
__pycache__/

# pnpm local store (offline installs)
.pnpm-store/

# Owner-local files: campaign exports + deploy tooling, never commit.
balu-*.zip
deploy-ftp.py
deploy-sync.sh
