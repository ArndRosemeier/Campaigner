{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Type safety — maximum strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // `scripts/**/*.ts` holds the build-time seams the config imports (docs/17
  // row 379: `scripts/swVersion.ts`, the service worker's content version).
  // Listing them here is what lets `eslint`'s type-aware project service see
  // them at all — a `.ts` file in NO project is a lint PARSE error, not a
  // warning ("was not found by the project service").
  "include": ["vite.config.ts", "scripts/**/*.ts"]
}
